# USSD shortcode shown in the in-app simulator (optional — fetched from API when available)
VITE_USSD_SHORTCODE=*384*45670#

# Frontend API URL (browser + Vercel). Set to Railway URL in production.
# Backend API (local dev)
VITE_API_BASE_URL=http://localhost:3000
# Production (Vercel): set in Vercel env vars, e.g. https://fresh-link-production.up.railway.app

# Native APK API URL (optional — falls back to VITE_API_BASE_URL)
VITE_API_BASE_URL_NATIVE=http://127.0.0.1:3001

# Sentry DSN for frontend error tracking (optional in dev)
VITE_SENTRY_DSN=

# Paystack public key (used client-side to initialise Paystack popup)
VITE_PAYSTACK_PUBLIC_KEY=

# Firebase project config (web push + Capacitor)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
