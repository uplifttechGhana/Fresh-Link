generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  buyer
  farmer
  transport
  investor
  admin
}

enum OtpPurpose {
  registration
  login
  password_reset
}

enum ProduceStatus {
  active
  out_of_stock
  deleted
}

enum OrderStatus {
  pending
  accepted
  preparing
  ready_for_pickup
  in_transit
  delivered
  cancelled
  disputed
}

enum TransportJobStatus {
  pending
  accepted
  picked_up
  in_transit
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum TransactionType {
  credit
  debit
}

enum TransactionSource {
  order_payment
  transport_fee
  investment_return
  withdrawal
  refund
  investment
  funding_disbursement
}

enum PayoutAccountType {
  mobile_money
  bank
}

enum WithdrawalStatus {
  pending
  processing
  success
  failed
}

enum InvestmentStatus {
  pending
  active
  completed
  cancelled
}

enum FundingRequestStatus {
  open
  funded
  closed
  cancelled
}

enum NotificationType {
  order_update
  payment
  message
  job_offer
  investment
  system
}

enum ReviewTargetType {
  farmer
  transport
}

enum UssdSessionStatus {
  active
  completed
  timeout
}

enum CropHealthStatus {
  healthy
  possible_disease
  possible_pest
  unclear
}

// ─────────────────────────────────────────────────────────────────────────────
// Core user + profiles
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  role         UserRole
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String?
  language     String   @default("en")
  avatarUrl    String?
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  fcmToken     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  farmerProfile   FarmerProfile?
  transportProfile TransportProfile?
  investorProfile InvestorProfile?

  otps             Otp[]
  buyerOrders      Order[]              @relation("BuyerOrders")
  notifications    Notification[]
  sentMessages     Message[]            @relation("SentMessages")
  buyerConversations Conversation[]     @relation("BuyerConversations")
  farmerConversations Conversation[]    @relation("FarmerConversations")
  savedFarmers     SavedFarmer[]        @relation("BuyerSaved")
  savedAsFarmer    SavedFarmer[]        @relation("FarmerSaved")
  favorites        Favorite[]
  reviews          Review[]             @relation("ReviewAuthor")
  wallet           Wallet?
  fundingRequests  FarmerFundingRequest[]
  investments      Investment[]
  deviceTokens     DeviceToken[]
  paymentMethods   PaymentMethod[]
  payoutAccounts   PayoutAccount[]
  withdrawalRequests WithdrawalRequest[]
  disputesReported Dispute[]            @relation("DisputeReporter")
  cropScans        CropScan[]

  @@map("users")
}

model FarmerProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmName    String?
  location    String?
  description String?
  latitude    Float?
  longitude   Float?
  bankName    String?
  bankAccount String?
  rating      Float   @default(0)
  totalReviews Int    @default(0)

  produce     ProduceListing[]
  orders      Order[]           @relation("FarmerOrders")
  transportRequests TransportRequest[]

  @@map("farmer_profiles")
}

model TransportProfile {
  id              String  @id @default(uuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType     String?
  vehiclePlate    String?
  vehicleCapacity String?
  vehiclePhotoUrl String?
  isAvailable     Boolean @default(false)
  latitude        Float?
  longitude       Float?
  rating          Float   @default(0)
  totalReviews    Int     @default(0)

  jobs TransportJob[]

  @@map("transport_profiles")
}

model InvestorProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio    String?

  @@map("investor_profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// OTP
// ─────────────────────────────────────────────────────────────────────────────

model Otp {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@map("otps")
}

// ─────────────────────────────────────────────────────────────────────────────
// Produce listings
// ─────────────────────────────────────────────────────────────────────────────

model ProduceListing {
  id          String        @id @default(uuid())
  farmerId    String
  farmer      FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  price       Float
  unit        String
  stock       Float
  category    String?
  images      String[]
  video       String?
  status      ProduceStatus @default(active)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orderItems  OrderItem[]
  cartItems   CartItem[]
  favorites   Favorite[]
  priceHistory PriceHistory[]

  @@map("produce_listings")
}

model PriceHistory {
  id        String         @id @default(uuid())
  produceId String
  produce   ProduceListing @relation(fields: [produceId], references: [id], onDelete: Cascade)
  price     Float
  recordedAt DateTime      @default(now())

  @@map("price_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// Cart
// ─────────────────────────────────────────────────────────────────────────────

model Cart {
  id        String     @id @default(uuid())
  buyerId   String     @unique
  items     CartItem[]
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  produceId String
  produce   ProduceListing @relation(fields: [produceId], references: [id])
  quantity  Float
  createdAt DateTime       @default(now())

  @@map("cart_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(uuid())
  buyerId         String
  buyer           User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  farmerId        String
  farmer          FarmerProfile @relation("FarmerOrders", fields: [farmerId], references: [id])
  status          OrderStatus @default(pending)
  subtotal        Float
  deliveryFee     Float       @default(0)
  total           Float
  deliveryAddress String?
  notes           String?
  paymentStatus   PaymentStatus @default(pending)
  paystackRef     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items        OrderItem[]
  transportJob TransportJob?
  conversation Conversation?
  invoice      Invoice?
  reviews      Review[]
  dispute      Dispute?

  @@map("orders")
}

model OrderItem {
  id        String         @id @default(uuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  produceId String
  produce   ProduceListing @relation(fields: [produceId], references: [id])
  quantity  Float
  unitPrice Float
  total     Float

  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Transport
// ─────────────────────────────────────────────────────────────────────────────

model TransportRequest {
  id         String           @id @default(uuid())
  farmerId   String
  farmer     FarmerProfile    @relation(fields: [farmerId], references: [id])
  pickup     String
  dropoff    String
  distance   Float?
  weight     Float?
  notes      String?
  createdAt  DateTime         @default(now())

  job TransportJob?

  @@map("transport_requests")
}

model TransportJob {
  id           String             @id @default(uuid())
  orderId      String?            @unique
  order        Order?             @relation(fields: [orderId], references: [id])
  requestId    String?            @unique
  request      TransportRequest?  @relation(fields: [requestId], references: [id])
  transporterId String?
  transporter  TransportProfile?  @relation(fields: [transporterId], references: [id])
  pickup       String
  dropoff      String
  distance     Float?
  fee          Float
  status       TransportJobStatus @default(pending)
  acceptedAt   DateTime?
  pickedUpAt   DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("transport_jobs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Chat
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id        String    @id @default(uuid())
  orderId   String?   @unique
  order     Order?    @relation(fields: [orderId], references: [id])
  buyerId   String
  buyer     User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  farmerId  String
  farmer    User      @relation("FarmerConversations", fields: [farmerId], references: [id])
  createdAt DateTime  @default(now())

  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  body           String
  imageUrl       String?
  audioUrl       String?
  audioDuration  Int?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Wallet & transactions
// ─────────────────────────────────────────────────────────────────────────────

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Float    @default(0)
  currency  String   @default("GHS")
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  withdrawals  WithdrawalRequest[]

  @@map("wallets")
}

model PayoutAccount {
  id                    String            @id @default(uuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  PayoutAccountType
  provider              String
  accountNumber         String
  accountName           String
  paystackRecipientCode String            @unique
  isDefault             Boolean           @default(false)
  createdAt             DateTime          @default(now())

  withdrawals WithdrawalRequest[]

  @@unique([userId, type, accountNumber])
  @@map("payout_accounts")
}

model WithdrawalRequest {
  id                   String           @id @default(uuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId             String
  wallet               Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  payoutAccountId      String
  payoutAccount        PayoutAccount    @relation(fields: [payoutAccountId], references: [id])
  amount               Float
  status               WithdrawalStatus @default(pending)
  paystackReference    String           @unique
  paystackTransferCode String?
  failureReason        String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@map("withdrawal_requests")
}

model Transaction {
  id        String            @id @default(uuid())
  walletId  String
  wallet    Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type      TransactionType
  source    TransactionSource
  amount    Float
  balance   Float
  reference String?
  note      String?
  createdAt DateTime          @default(now())

  @@map("transactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Invoice
// ─────────────────────────────────────────────────────────────────────────────

model Invoice {
  id        String   @id @default(uuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  number    String   @unique
  issuedAt  DateTime @default(now())
  dueAt     DateTime?
  paidAt    DateTime?

  @@map("invoices")
}

// ─────────────────────────────────────────────────────────────────────────────
// Reviews
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id         String           @id @default(uuid())
  targetType ReviewTargetType
  targetId   String
  orderId    String?
  order      Order?           @relation(fields: [orderId], references: [id])
  authorId   String
  author     User             @relation("ReviewAuthor", fields: [authorId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime         @default(now())

  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Saved farmers / Favorites
// ─────────────────────────────────────────────────────────────────────────────

model SavedFarmer {
  id        String   @id @default(uuid())
  buyerId   String
  buyer     User     @relation("BuyerSaved", fields: [buyerId], references: [id], onDelete: Cascade)
  farmerId  String
  farmer    User     @relation("FarmerSaved", fields: [farmerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([buyerId, farmerId])
  @@map("saved_farmers")
}

model Favorite {
  id        String         @id @default(uuid())
  buyerId   String
  buyer     User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  produceId String
  produce   ProduceListing @relation(fields: [produceId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([buyerId, produceId])
  @@map("favorites")
}

// ─────────────────────────────────────────────────────────────────────────────
// Investor / Funding
// ─────────────────────────────────────────────────────────────────────────────

model FarmerFundingRequest {
  id          String               @id @default(uuid())
  farmerId    String
  farmer      User                 @relation(fields: [farmerId], references: [id])
  title       String
  description String?
  goal        Float
  raised      Float                @default(0)
  status      FundingRequestStatus @default(open)
  deadline    DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  investments Investment[]

  @@map("farmer_funding_requests")
}

model Investment {
  id        String           @id @default(uuid())
  investorId String
  investor  User             @relation(fields: [investorId], references: [id])
  requestId String
  request   FarmerFundingRequest @relation(fields: [requestId], references: [id])
  amount    Float
  status    InvestmentStatus @default(pending)
  paystackRef String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("investments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Knowledge Hub (articles / videos)
// ─────────────────────────────────────────────────────────────────────────────

model KnowledgeArticle {
  id          String   @id @default(uuid())
  title       String
  body        String
  category    String?
  thumbnailUrl String?
  videoUrl    String?
  isVideo     Boolean  @default(false)
  authorId    String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("knowledge_articles")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI crop scan (Gemini)
// ─────────────────────────────────────────────────────────────────────────────

model CropScan {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl     String
  crop         String?
  confidence   Float?
  healthStatus CropHealthStatus?
  diseasesJson Json?
  advice       String?
  rawResponse  Json?
  createdAt    DateTime          @default(now())

  @@index([userId, createdAt])
  @@map("crop_scans")
}

// ─────────────────────────────────────────────────────────────────────────────
// USSD session state machine
// ─────────────────────────────────────────────────────────────────────────────

model UssdSession {
  id          String            @id @default(uuid())
  sessionId   String            @unique
  phoneNumber String
  userId      String?
  state       String            @default("MAIN_MENU")
  data        Json?
  status      UssdSessionStatus @default(active)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("ussd_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Device tokens (for push notifications)
// ─────────────────────────────────────────────────────────────────────────────

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  @@map("device_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Payment methods (saved MoMo / card per user)
// ─────────────────────────────────────────────────────────────────────────────

model PaymentMethod {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String
  accountNumber String
  label         String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@map("payment_methods")
}

// ─────────────────────────────────────────────────────────────────────────────
// Order disputes
// ─────────────────────────────────────────────────────────────────────────────

model Dispute {
  id          String    @id @default(uuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id])
  reporterId  String
  reporter    User      @relation("DisputeReporter", fields: [reporterId], references: [id])
  reason      String
  description String?
  status      String    @default("open")
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("disputes")
}
