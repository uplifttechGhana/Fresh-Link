# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/freshlink?schema=public

# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_64chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_64chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Africa's Talking (OTP + USSD) ──────────────────────────────────────────
# 1. Sign up: https://account.africastalking.com
# 2. Sandbox → Settings → API Key → generate key (username stays "sandbox")
# 3. Sandbox → Launch Simulator → enter your test +233 number (messages show in simulator, not real SMS)
# 4. For USSD: create a service in sandbox, set callback to:
#    https://YOUR_PUBLIC_URL/api/v1/ussd/callback  (ngrok for local dev)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SHORTCODE=*384*45670#
# Custom sender — live only (ignored in sandbox; AT uses AFRICASTKNG)
AFRICASTALKING_SENDER_ID=FreshLink

# ─── Paystack ───────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=
# Simulate wallet withdrawals when Paystack blocks transfers (starter/test accounts)
WALLET_SIMULATE_WITHDRAWALS=true

# ─── Cloudinary (recommended — easy free tier, image optimization) ────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── S3 / Cloudflare R2 (alternative) ───────────────────────────────────────
# AWS S3: leave STORAGE_ENDPOINT empty. R2: set endpoint to your R2 URL.
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=freshlink-uploads
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public base URL for uploaded files (optional for AWS — auto-generated if empty)
STORAGE_PUBLIC_URL=

# ─── Firebase Admin SDK (push notifications) ────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Admin ──────────────────────────────────────────────────────────────────
# Comma-separated phone numbers promoted to admin role automatically on boot.
ADMIN_PHONES=
# Secret code required to use the /admin/register page.
# Share this only with trusted staff. Change it after first use.
ADMIN_SETUP_CODE=change-me-before-production

# ─── Sentry ─────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── YouTube (Knowledge Hub videos) ─────────────────────────────────────────
# Optional. When set, searches YouTube Data API v3. Without it, RSS + curated fallbacks are used.
YOUTUBE_API_KEY=

# ─── Google Gemini (crop scan) ───────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey — never commit the real value.
GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
GEMINI_MODEL=
